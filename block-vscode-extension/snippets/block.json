{
  "if block": {
    "prefix": ["if", "ifblock"],
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}",
      "block"
    ],
    "description": "If conditional statement"
  },
  "if else block": {
    "prefix": ["ife", "ifelse"],
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}",
      "else:",
      "\t${3:pass}",
      "block"
    ],
    "description": "If-Else conditional statement"
  },
  "while block": {
    "prefix": ["while", "loop"],
    "body": [
      "while ${1:condition}:",
      "\t${2:pass}",
      "block"
    ],
    "description": "While loop"
  },
  "for block": {
    "prefix": ["for"],
