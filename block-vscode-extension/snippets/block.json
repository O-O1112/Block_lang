  "boilerplate main": {
    "prefix": ["main", "init", "start"],
    "body": [
      "print(\"--- Block Polyglot Script Started ---\")",
      "",
      "${1:var_name} = ${2:100}",
      "",
      "<py>",
      "print(f\"Python received {1}: {${1:var_name}}\")",
      "${1:var_name} = ${1:var_name} + 50",
      "</py>",
      "",
      "<js>",
      "console.log(`JS received ${1}: ${${1:var_name}}`);",
      "</js>",
      "",
      "print(\"Final Result:\", ${1:var_name})"
